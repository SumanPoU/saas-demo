// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  email              String    @unique
  emailVerified      Boolean   @default(false)
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  firstName          String?
  lastName           String?
  avatarUrl          String?
  isActive           Boolean   @default(true)
  isSuperAdmin       Boolean   @default(false)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Role relations
  roles                   Role[]           @relation("UserRoles")
  rolePermissionsAssigned RolePermission[] @relation("RolePermissionAssignedBy")

  // Permission relations
  permissionsCreated      Permission[]      @relation("PermissionCreatedBy")
  permissionGroupsCreated PermissionGroup[] @relation("PermissionGroupCreatedBy")

  // Session & token relations
  sessions                UserSession[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mfaConfig               MfaConfig?
  mfaRecoveryTokens       MfaRecoveryToken[]
  oauthAccounts           OAuthAccount[]

  // Audit
  auditLogs AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]           @relation("UserRoles")
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  groups      PermissionGroup[] @relation("GroupPermissions")
  createdBy   String?           @db.Uuid
  createdUser User?             @relation("PermissionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model PermissionGroup {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  permissions Permission[] @relation("GroupPermissions")

  createdBy   String? @db.Uuid
  createdUser User?   @relation("PermissionGroupCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permission_groups")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  assignedById String? @db.Uuid
  assignedBy   User?   @relation("RolePermissionAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String

  // Device / client metadata
  deviceName String? // e.g. "iPhone 15", "Chrome on Windows"
  deviceType String? // e.g. "mobile", "desktop", "tablet"
  platform   String? // e.g. "iOS", "Windows", "Android"
  userAgent  String?
  ipAddress  String?

  isRevoked Boolean   @default(false)
  revokedAt DateTime?
  revokedBy String?   @db.Uuid // userId who triggered revocation (for admin force-logout)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // hard session TTL (e.g. 90 days of inactivity)

  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([tenantId, userId])
  @@map("user_sessions")
}

model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String

  tokenHash String    @unique // sha256 of the raw token sent to client
  familyId  String // groups rotation chain; reuse of any token in family revokes all
  isUsed    Boolean   @default(false)
  isRevoked Boolean   @default(false)
  usedAt    DateTime?
  revokedAt DateTime?

  // Successor token (populated when this token is rotated)
  replacedByTokenId String?

  createdAt DateTime @default(now())
  expiresAt DateTime // e.g. now + 30 days

  @@index([userId])
  @@index([familyId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String

  tokenHash String    @unique
  isUsed    Boolean   @default(false)
  usedAt    DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime // e.g. now + 1 hour

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  email    String // the email being verified (may differ from current user.email)
  purpose  String @default("email_verify")

  tokenHash String    @unique
  isUsed    Boolean   @default(false)
  usedAt    DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime // e.g. now + 24 hours

  @@index([userId])
  @@map("email_verification_tokens")
}

model MfaConfig {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  method    String // e.g. "totp", "webauthn"
  isEnabled Boolean @default(false)

  // TOTP fields (encrypted at rest via app-layer encryption before storing)
  totpSecret     String? // base32 seed, encrypted
  totpVerifiedAt DateTime? // null until user completes first TOTP verification

  // Backup / recovery codes (bcrypt-hashed, single-use)
  backupCodes MfaBackupCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mfa_configs")
}

model MfaBackupCode {
  id          String    @id @default(uuid()) @db.Uuid
  mfaConfigId String    @db.Uuid
  mfaConfig   MfaConfig @relation(fields: [mfaConfigId], references: [id], onDelete: Cascade)

  codeHash String    @unique // bcrypt of the raw 8-char code shown to user
  isUsed   Boolean   @default(false)
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([mfaConfigId])
  @@map("mfa_backup_codes")
}

model GlobalConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  category  String?
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("global_config")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String
  actorId    String   @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  payload    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OAuthAccount {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String // e.g. "google", "github"
  providerId String // unique id on Google/GitHub
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model MfaRecoveryToken {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String

  tokenHash String    @unique
  isUsed    Boolean   @default(false)
  usedAt    DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@map("mfa_recovery_tokens")
}
