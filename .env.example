# Copy to `.env` or `.env.development.local` — never commit real secrets.

# --- Required (validated at startup) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"
JWT_SECRET="change-me-at-least-32-random-characters"
JWT_REFRESH_SECRET="change-me-different-32-char-secret"
# 64 hex characters (32 bytes) — used to encrypt TOTP secrets at rest
MFA_ENCRYPTION_KEY="d3b07384d113edec49eaa6238ad5ff00b178e5d2900ee61f9d4d38c641ef65b9"

# --- Recommended ---
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5173

SEED_SUPERADMIN_PASSWORD="change-me-local-only"
SEED_USER_PASSWORD="change-me-local-only"

MAIL_USER=mock-user
MAIL_PASS=mock-pass

# --- Optional: OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# --- Optional: MinIO (required in production for media) ---
# In development, localhost/minioadmin defaults are allowed with a warning.
# In production, MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY must be set.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=my-app-uploads

# --- Optional: throttle overrides (also tunable via GlobalConfig key `throttle`) ---
# THROTTLE_SHORT_TTL=1000
# THROTTLE_SHORT_LIMIT=10
# THROTTLE_LONG_TTL=60000
# THROTTLE_LONG_LIMIT=100
# THROTTLE_AUTH_TTL=60000
# THROTTLE_AUTH_LIMIT=5
